{
    "name": "rumahsakitu/simrs",
    "type": "project",
    "description": "Sistem Informasi Manajemen Rumah Sakit - RumahSakitKu",
    "keywords": ["laravel", "filament", "simrs", "hospital", "management"],
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-dompdf": "^3.1",
        "filament/filament": "~4.0",
        "filament/spatie-laravel-settings-plugin": "~4.0",
        "guzzlehttp/guzzle": "^7.9",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.10",
        "maatwebsite/excel": "^3.1",
        "predis/predis": "^2.3",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "spatie/laravel-permission": "^6.16"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "filament/upgrade": "^4.0",
        "friendsofphp/php-cs-fixer": "^3.68",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.21",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.7",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5",
        "spatie/laravel-ignition": "^2.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan migrate --ansi"
        ],
        "test": "php artisan test",
        "analyse": "phpstan analyse --memory-limit=2G",
        "format": "php-cs-fixer fix --allow-risky=yes",
        "format-check": "php-cs-fixer fix --dry-run --diff"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.2.30"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
