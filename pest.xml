<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         testSuiteLoaderClass="Pest\TestSuiteLoader"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Filament">
            <directory>tests/Filament</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>app</directory>
        </include>
        <exclude>
            <directory>app/Console</directory>
            <directory>app/Exceptions</directory>
            <directory>app/Providers</directory>
        </exclude>
    </source>

    <coverage>
        <report>
            <html outputDirectory="storage/app/coverage"/>
            <clover outputFile="coverage.xml"/>
            <text outputFile="php://stdout"/>
        </report>
    </coverage>

    <logging>
        <junit outputFile="storage/app/test-results.xml"/>
        <testdoxHtml outputFile="storage/app/testdox.html"/>
        <testdoxText outputFile="storage/app/testdox.txt"/>
    </logging>

    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:Dw31y2C8IvO4lPX0jTGQSbPSBEoMOm8hT2XqIF6s0Z8="/>
        <env name="APP_DEBUG" value="true"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="FILAMENT_DEBUG" value="false"/>
    </php>

    <extensions>
        <!-- PHPUnit extension for parallel testing -->
        <bootstrap class="ParaTest\Runners\PHPUnit\Runner">
            <parameter name="--processes" value="4"/>
            <parameter name="--functional"/>
        </bootstrap>
    </extensions>
</phpunit>
