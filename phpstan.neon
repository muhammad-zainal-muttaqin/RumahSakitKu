includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # Analysis level (0-9, where 9 is max)
    level: 5

    # Paths to analyze
    paths:
        - app

    # Ignore specific errors (for Laravel quirks)
    ignoreErrors:
        # Laravel facades dynamic methods
        - '#Call to an undefined static method Illuminate\\Support\\Facades\\.*#'
        # Eloquent dynamic properties
        - '#Access to an undefined property App\\Models\\.*#'
        # Route model binding
        - '#Cannot access property \$.* on App\\Models\\.*\|null#'
        # Filament dynamic methods
        - '#Call to an undefined method.*Filament\\.*#'
        # Mixed type operations common in Laravel
        - '#Parameter .* of .* expects .*, mixed given#'

    # Parallel processing
    parallel:
        maximumNumberOfProcesses: 4

    # Cache configuration
    tmpDir: storage/app/phpstan
