# SIMRS Testing Environment Configuration
# Copy this file to .env.testing and modify as needed

# ============================================
# Application
# ============================================
APP_NAME="SIMRS Testing"
APP_ENV=testing
APP_KEY=base64:Dw31y2C8IvO4lPX0jTGQSbPSBEoMOm8hT2XqIF6s0Z8=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ============================================
# Logging
# ============================================
LOG_CHANNEL=daily
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

# ============================================
# Database
# ============================================
# SQLite (default for testing - in-memory)
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

# Alternative: MySQL for integration testing
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=simrs_test
# DB_USERNAME=root
# DB_PASSWORD=

# ============================================
# Cache
# ============================================
# Using array driver for testing (no persistence)
CACHE_DRIVER=array
CACHE_PREFIX=simrs_test

# Alternative: Redis
# CACHE_DRIVER=redis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379
# REDIS_DB=1

# ============================================
# Session
# ============================================
# Using array driver for testing
SESSION_DRIVER=array
SESSION_LIFETIME=120

# ============================================
# Queue
# ============================================
# Using sync driver for immediate execution in tests
QUEUE_CONNECTION=sync

# Alternative: Database queue for testing async jobs
# QUEUE_CONNECTION=database

# ============================================
# Mail
# ============================================
# Using array driver (no actual emails sent)
MAIL_MAILER=array
MAIL_HOST=localhost
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=test@simrs.test
MAIL_FROM_NAME="SIMRS Test"

# ============================================
# Broadcasting
# ============================================
BROADCAST_DRIVER=log

# ============================================
# File Storage
# ============================================
FILESYSTEM_DISK=local

# ============================================
# Filament Configuration
# ============================================
FILAMENT_DEBUG=false
FILAMENT_PATH=admin

# ============================================
# Telescope (Debug Tool)
# ============================================
TELESCOPE_ENABLED=false

# ============================================
# Debugbar
# ============================================
DEBUGBAR_ENABLED=false

# ============================================
# Testing Specific
# ============================================
# PHPUnit test environment variables
BCRYPT_ROUNDS=4

# Speed up hashing for tests
HASH_DRIVER=bcrypt

# Faster password hashing
PASSWORD_BCRYPT_ROUNDS=4

# ============================================
# API Configuration
# ============================================
# Test API credentials
API_KEY=test-api-key

# ============================================
# Third Party Services (Testing/Sandbox)
# ============================================

# Example: Payment Gateway (Sandbox mode)
MIDTRANS_SERVER_KEY=SB-Mid-server-test-key
MIDTRANS_CLIENT_KEY=SB-Mid-client-test-key
MIDTRANS_IS_PRODUCTION=false

# Example: SMS Gateway (Mock)
SMS_GATEWAY_DRIVER=log

# Example: WhatsApp API (Mock)
WHATSAPP_API_KEY=test-key
WHATSAPP_API_URL=https://api.test.example.com

# ============================================
# Feature Flags (for testing)
# ============================================
FEATURE_NEW_REGISTRATION=true
FEATURE_ONLINE_PAYMENT=false
FEATURE_TELEMEDICINE=true

# ============================================
# Testing Database Seeding
# ============================================
# Controls whether database is seeded during testing
DB_SEED_IN_TESTS=false
